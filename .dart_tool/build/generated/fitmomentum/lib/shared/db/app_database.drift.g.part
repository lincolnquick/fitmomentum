class UserCharacteristic extends DataClass
    implements Insertable<UserCharacteristic> {
  final int id;
  final DateTime? dateOfBirth;
  final String sex;
  final double? heightMeters;
  final double? weightKg;
  final DateTime? capturedAt;
  const UserCharacteristic({
    required this.id,
    this.dateOfBirth,
    required this.sex,
    this.heightMeters,
    this.weightKg,
    this.capturedAt,
  });
  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    map['id'] = Variable<int>(id);
    if (!nullToAbsent || dateOfBirth != null) {
      map['date_of_birth'] = Variable<DateTime>(dateOfBirth);
    }
    map['sex'] = Variable<String>(sex);
    if (!nullToAbsent || heightMeters != null) {
      map['height_meters'] = Variable<double>(heightMeters);
    }
    if (!nullToAbsent || weightKg != null) {
      map['weight_kg'] = Variable<double>(weightKg);
    }
    if (!nullToAbsent || capturedAt != null) {
      map['captured_at'] = Variable<DateTime>(capturedAt);
    }
    return map;
  }

  UserCharacteristicsCompanion toCompanion(bool nullToAbsent) {
    return UserCharacteristicsCompanion(
      id: Value(id),
      dateOfBirth: dateOfBirth == null && nullToAbsent
          ? const Value.absent()
          : Value(dateOfBirth),
      sex: Value(sex),
      heightMeters: heightMeters == null && nullToAbsent
          ? const Value.absent()
          : Value(heightMeters),
      weightKg: weightKg == null && nullToAbsent
          ? const Value.absent()
          : Value(weightKg),
      capturedAt: capturedAt == null && nullToAbsent
          ? const Value.absent()
          : Value(capturedAt),
    );
  }

  factory UserCharacteristic.fromJson(
    Map<String, dynamic> json, {
    ValueSerializer? serializer,
  }) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return UserCharacteristic(
      id: serializer.fromJson<int>(json['id']),
      dateOfBirth: serializer.fromJson<DateTime?>(json['dateOfBirth']),
      sex: serializer.fromJson<String>(json['sex']),
      heightMeters: serializer.fromJson<double?>(json['heightMeters']),
      weightKg: serializer.fromJson<double?>(json['weightKg']),
      capturedAt: serializer.fromJson<DateTime?>(json['capturedAt']),
    );
  }
  @override
  Map<String, dynamic> toJson({ValueSerializer? serializer}) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return <String, dynamic>{
      'id': serializer.toJson<int>(id),
      'dateOfBirth': serializer.toJson<DateTime?>(dateOfBirth),
      'sex': serializer.toJson<String>(sex),
      'heightMeters': serializer.toJson<double?>(heightMeters),
      'weightKg': serializer.toJson<double?>(weightKg),
      'capturedAt': serializer.toJson<DateTime?>(capturedAt),
    };
  }

  UserCharacteristic copyWith({
    int? id,
    Value<DateTime?> dateOfBirth = const Value.absent(),
    String? sex,
    Value<double?> heightMeters = const Value.absent(),
    Value<double?> weightKg = const Value.absent(),
    Value<DateTime?> capturedAt = const Value.absent(),
  }) => UserCharacteristic(
    id: id ?? this.id,
    dateOfBirth: dateOfBirth.present ? dateOfBirth.value : this.dateOfBirth,
    sex: sex ?? this.sex,
    heightMeters: heightMeters.present ? heightMeters.value : this.heightMeters,
    weightKg: weightKg.present ? weightKg.value : this.weightKg,
    capturedAt: capturedAt.present ? capturedAt.value : this.capturedAt,
  );
  UserCharacteristic copyWithCompanion(UserCharacteristicsCompanion data) {
    return UserCharacteristic(
      id: data.id.present ? data.id.value : this.id,
      dateOfBirth: data.dateOfBirth.present
          ? data.dateOfBirth.value
          : this.dateOfBirth,
      sex: data.sex.present ? data.sex.value : this.sex,
      heightMeters: data.heightMeters.present
          ? data.heightMeters.value
          : this.heightMeters,
      weightKg: data.weightKg.present ? data.weightKg.value : this.weightKg,
      capturedAt: data.capturedAt.present
          ? data.capturedAt.value
          : this.capturedAt,
    );
  }

  @override
  String toString() {
    return (StringBuffer('UserCharacteristic(')
          ..write('id: $id, ')
          ..write('dateOfBirth: $dateOfBirth, ')
          ..write('sex: $sex, ')
          ..write('heightMeters: $heightMeters, ')
          ..write('weightKg: $weightKg, ')
          ..write('capturedAt: $capturedAt')
          ..write(')'))
        .toString();
  }

  @override
  int get hashCode =>
      Object.hash(id, dateOfBirth, sex, heightMeters, weightKg, capturedAt);
  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      (other is UserCharacteristic &&
          other.id == this.id &&
          other.dateOfBirth == this.dateOfBirth &&
          other.sex == this.sex &&
          other.heightMeters == this.heightMeters &&
          other.weightKg == this.weightKg &&
          other.capturedAt == this.capturedAt);
}

class UserCharacteristicsCompanion extends UpdateCompanion<UserCharacteristic> {
  final Value<int> id;
  final Value<DateTime?> dateOfBirth;
  final Value<String> sex;
  final Value<double?> heightMeters;
  final Value<double?> weightKg;
  final Value<DateTime?> capturedAt;
  const UserCharacteristicsCompanion({
    this.id = const Value.absent(),
    this.dateOfBirth = const Value.absent(),
    this.sex = const Value.absent(),
    this.heightMeters = const Value.absent(),
    this.weightKg = const Value.absent(),
    this.capturedAt = const Value.absent(),
  });
  UserCharacteristicsCompanion.insert({
    this.id = const Value.absent(),
    this.dateOfBirth = const Value.absent(),
    this.sex = const Value.absent(),
    this.heightMeters = const Value.absent(),
    this.weightKg = const Value.absent(),
    this.capturedAt = const Value.absent(),
  });
  static Insertable<UserCharacteristic> custom({
    Expression<int>? id,
    Expression<DateTime>? dateOfBirth,
    Expression<String>? sex,
    Expression<double>? heightMeters,
    Expression<double>? weightKg,
    Expression<DateTime>? capturedAt,
  }) {
    return RawValuesInsertable({
      if (id != null) 'id': id,
      if (dateOfBirth != null) 'date_of_birth': dateOfBirth,
      if (sex != null) 'sex': sex,
      if (heightMeters != null) 'height_meters': heightMeters,
      if (weightKg != null) 'weight_kg': weightKg,
      if (capturedAt != null) 'captured_at': capturedAt,
    });
  }

  UserCharacteristicsCompanion copyWith({
    Value<int>? id,
    Value<DateTime?>? dateOfBirth,
    Value<String>? sex,
    Value<double?>? heightMeters,
    Value<double?>? weightKg,
    Value<DateTime?>? capturedAt,
  }) {
    return UserCharacteristicsCompanion(
      id: id ?? this.id,
      dateOfBirth: dateOfBirth ?? this.dateOfBirth,
      sex: sex ?? this.sex,
      heightMeters: heightMeters ?? this.heightMeters,
      weightKg: weightKg ?? this.weightKg,
      capturedAt: capturedAt ?? this.capturedAt,
    );
  }

  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    if (id.present) {
      map['id'] = Variable<int>(id.value);
    }
    if (dateOfBirth.present) {
      map['date_of_birth'] = Variable<DateTime>(dateOfBirth.value);
    }
    if (sex.present) {
      map['sex'] = Variable<String>(sex.value);
    }
    if (heightMeters.present) {
      map['height_meters'] = Variable<double>(heightMeters.value);
    }
    if (weightKg.present) {
      map['weight_kg'] = Variable<double>(weightKg.value);
    }
    if (capturedAt.present) {
      map['captured_at'] = Variable<DateTime>(capturedAt.value);
    }
    return map;
  }

  @override
  String toString() {
    return (StringBuffer('UserCharacteristicsCompanion(')
          ..write('id: $id, ')
          ..write('dateOfBirth: $dateOfBirth, ')
          ..write('sex: $sex, ')
          ..write('heightMeters: $heightMeters, ')
          ..write('weightKg: $weightKg, ')
          ..write('capturedAt: $capturedAt')
          ..write(')'))
        .toString();
  }
}

